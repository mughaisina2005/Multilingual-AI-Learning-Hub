# Server Configuration
PORT=3000
NODE_ENV=development

# Session Encryption Secret
SESSION_SECRET=replace_with_a_secure_random_string

# Optional: Google Gemini API Key for dynamic AI Tutoring & Audio
GEMINI_API_KEY=

# Optional: Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Optional Persistent Cloud Database (Turso / LibSQL for Vercel multi-instance persistence)
# If not set, SQLite automatically runs in local /data or Vercel /tmp storage
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
